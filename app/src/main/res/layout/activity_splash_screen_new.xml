<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    tools:context=".presentation.activity.SplashScreenActivity">

    <!-- Background gradient overlay -->
    <View
        android:id="@+id/gradientOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_gradient_bg"
        android:alpha="0.8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main TAMAADE Text -->
    <TextView
        android:id="@+id/mainText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TAMAADE"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.2"
        android:elevation="12dp"
        android:shadowColor="#000000"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        android:alpha="0"
        android:scaleX="0.3"
        android:scaleY="0.3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4" />

    <!-- Subtitle text -->
    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="E-Commerce Redefined"
        android:textSize="18sp"
        android:textStyle="italic"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.3"
        android:alpha="0"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mainText" />

    <!-- Animated particles -->
    <View
        android:id="@+id/particle1"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/particle_circle"
        android:alpha="0"
        app:layout_constraintBottom_toTopOf="@+id/mainText"
        app:layout_constraintStart_toStartOf="@+id/mainText"
        android:layout_marginBottom="50dp"
        android:layout_marginStart="30dp" />

    <View
        android:id="@+id/particle2"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/particle_circle"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@+id/mainText"
        app:layout_constraintEnd_toEndOf="@+id/mainText"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="40dp" />

    <View
        android:id="@+id/particle3"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/particle_circle"
        android:alpha="0"
        app:layout_constraintBottom_toTopOf="@+id/mainText"
        app:layout_constraintEnd_toEndOf="@+id/mainText"
        android:layout_marginBottom="80dp"
        android:layout_marginEnd="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>