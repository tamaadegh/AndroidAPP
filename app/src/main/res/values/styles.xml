<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom Rating Bar Style -->
    <style name="GreenRatingBar" parent="Widget.AppCompat.RatingBar.Indicator">
        <item name="colorControlNormal">@color/textAd</item>
        <item name="colorControlActivated">@color/primary</item>
    </style>

    <!-- Custom Progress Bar Style -->
    <style name="GreenProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateDrawable">@drawable/progress_bar_green</item>
    </style>

    <!-- Enhanced Card Style -->
    <style name="ProfileCardStyle">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/backgroundAd</item>
        <item name="android:layout_marginHorizontal">10dp</item>
        <item name="android:layout_marginVertical">4dp</item>
    </style>

    <!-- Button Style -->
    <style name="PrimaryButtonStyle">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/metropolis_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:elevation">4dp</item>
    </style>
</resources>