<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never copy the session (JWT), basket or settings to the cloud or a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tamaade_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tamaade_session.xml" />
    </device-transfer>
</data-extraction-rules>
