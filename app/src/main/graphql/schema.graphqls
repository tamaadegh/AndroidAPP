type Query {
  cart: CartType

  product(slug: String): ProductGraphType

  products(offset: Int, before: String, after: String, first: Int, last: Int, name: String, summary: String, description: String, category: ID, categoryName: String, supplier: ID, brand: String, relatedTo: String, "Search Across Multiple Fields" search: String, collection: ID): ProductGraphTypeConnection

  categories(offset: Int, before: String, after: String, first: Int, last: Int, name: String): CategoryTypeConnection

  categoriesHierarchical(offset: Int, before: String, after: String, first: Int, last: Int, name: String): CategoryHierarchicalTypeConnection

  collections(offset: Int, before: String, after: String, first: Int, last: Int, name: String): CollectionTypeConnection

  tags(offset: Int, before: String, after: String, first: Int, last: Int, name: String): ProductTagTypeConnection
}

type CartType {
  items: [CartItemType]

  total: String
}

type CartItemType {
  productVariant: ProductVariantType

  quantity: Int

  subtotal: String
}

type ProductVariantType {
  name: String

  id: ID!

  price: String

  priceWithoutSymbol: String

  priceRaw: String
}

"""
The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.
"""
scalar String

"""
The `ID` scalar type represents a unique identifier, often used to refetch an object or as key for a cache. The ID type appears in a JSON response as a String; however, it is not intended to be human-readable. When expected as an input type, any string (such as `"4"`) or integer (such as `4`) input value will be accepted as an ID.
"""
scalar ID

"""
The `Int` scalar type represents non-fractional signed whole numeric values. Int can represent values between -(2^31) and 2^31 - 1.
"""
scalar Int

type ProductGraphType implements Node {
  """
  The ID of the object
  """
  id: ID!

  slug: String!

  category: CategoryHierarchicalType!

  brand: String

  defaultVariant: ProductVariantType

  collections(offset: Int, before: String, after: String, first: Int, last: Int, name: String): CollectionTypeConnection!

  tags(offset: Int, before: String, after: String, first: Int, last: Int, name: String): ProductTagTypeConnection!

  """
  Related products. For example, if you have a product that is a t-shirt, each product can have variants by size and color. In this case, you can relate all the products by color. This field is not intended for recommendation engines.
  """
  relatedTo(offset: Int, before: String, after: String, first: Int, last: Int, name: String, summary: String, description: String, category: ID, categoryName: String, supplier: ID, brand: String, relatedTo: String, "Search Across Multiple Fields" search: String, collection: ID): ProductGraphTypeConnection!

  variants: [ProductVariantType!]!

  alias: UUID!

  name: String

  summary: String

  description: String

  metaTitle: String

  metaDescription: String

  thumbnail: String

  price: String
}

"""
An object with an ID
"""
interface Node {
  """
  The ID of the object
  """
  id: ID!
}

type CategoryHierarchicalType implements Node {
  """
  The ID of the object
  """
  id: ID!

  name: String

  description: String

  metaTitle: String

  metaDescription: String

  children: [CategoryHierarchicalType]
}

type CollectionTypeConnection {
  """
  Pagination data for this connection.
  """
  pageInfo: PageInfo!

  """
  Contains the nodes in this connection.
  """
  edges: [CollectionTypeEdge]!
}

"""
The Relay compliant `PageInfo` type, containing data necessary to paginate this connection.
"""
type PageInfo {
  """
  When paginating forwards, are there more items?
  """
  hasNextPage: Boolean!

  """
  When paginating backwards, are there more items?
  """
  hasPreviousPage: Boolean!

  """
  When paginating backwards, the cursor to continue.
  """
  startCursor: String

  """
  When paginating forwards, the cursor to continue.
  """
  endCursor: String
}

"""
The `Boolean` scalar type represents `true` or `false`.
"""
scalar Boolean

"""
A Relay edge containing a `CollectionType` and its cursor.
"""
type CollectionTypeEdge {
  """
  The item at the end of the edge
  """
  node: CollectionType

  """
  A cursor for use in pagination
  """
  cursor: String!
}

type CollectionType implements Node {
  """
  The ID of the object
  """
  id: ID!

  name: String
}

